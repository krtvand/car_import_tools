{# The landing page: the saved searches, and nothing else. Styled from the same
   palette as the search pages so clicking through does not feel like leaving
   the tool. Self-contained — inline CSS, no images, no JavaScript — and every
   link is relative, so the set survives `runs/` being copied elsewhere. #}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>searches</title>
<style>
  :root {
    --ink: #1a1a1a; --muted: #6b6b6b; --line: #e0ddd7; --paper: #faf9f7;
    --card: #ffffff; --bad: #b3261e; --link: #1a4f8a;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 2rem 1.5rem 4rem; background: var(--paper); color: var(--ink);
    font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue",
          "Hiragino Sans", "Yu Gothic", Meiryo, sans-serif;
  }
  .wrap { max-width: 640px; margin: 0 auto; }

  header h1 { margin: 0 0 1.25rem; font-size: 1.4rem; font-weight: 600; }

  ol.searches { list-style: none; margin: 0; padding: 0; }
  .search {
    background: var(--card); border: 1px solid var(--line); border-radius: 8px;
    margin: 0 0 .625rem; padding: .75rem 1rem;
    display: flex; flex-wrap: wrap; gap: .25rem .75rem; align-items: baseline;
  }
  .search .name { font-weight: 600; font-size: 1.05rem;
                  font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .search .name a { color: var(--link); text-decoration: none; }
  .search .name a:hover { text-decoration: underline; }
  .search .lots { margin-left: auto; color: var(--muted); font-size: .8125rem;
                  letter-spacing: .04em; text-transform: uppercase; }

  /* Nothing to bid on is read at a glance across the whole list, so it is a
     property of the row rather than a word you have to find in it. */
  .search.quiet { background: none; }
  .search.quiet .name a { color: var(--muted); }

  /* A file that will not parse. Present and loud: a row missing from this list
     looks exactly like a search switched off on purpose. */
  .search.broken { border-left: 4px solid var(--bad); }
  .search.broken .name { color: var(--bad); }
  .search.broken .lots { margin-left: 0; flex: 1 1 100%; color: var(--bad);
                         text-transform: none; letter-spacing: 0; font-size: .875rem; }

  .empty { margin: 2rem 0; color: var(--muted); }
  .empty code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  footer { margin: 2rem 0 0; color: var(--muted); font-size: .8125rem; }
  footer code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
</style>
</head>
<body>
<div class="wrap">

<header>
  <h1>Searches</h1>
</header>

{% if not entries %}
  <p class="empty">No searches yet — write one in <code>searches/</code>.</p>
{% else %}
<ol class="searches">
  {% for entry in entries %}
  <li class="search{{ ' broken' if entry.problem }}{{ ' quiet' if not entry.problem and not entry.upcoming }}">
    <span class="name">
      {% if entry.problem %}
      {{ entry.name }}
      {% else %}
      <a href="{{ entry.href }}">{{ entry.name }}</a>
      {% endif %}
    </span>
    <span class="lots">{{ entry.summary }}</span>
  </li>
  {% endfor %}
</ol>
{% endif %}

<footer>Rebuilt {{ generated_at }} by <code>dashboard build</code>.</footer>

</div>
</body>
</html>
