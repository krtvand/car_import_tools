{# The landing page for `report --open`: the last N runs, newest first. Styled
   from report.html.j2's palette so clicking through does not feel like leaving
   the tool. Self-contained — inline CSS, no images, no JavaScript — and every
   link is relative, so the page survives `runs/` being copied elsewhere. #}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>auction runs</title>
<style>
  :root {
    --ink: #1a1a1a; --muted: #6b6b6b; --line: #e0ddd7; --paper: #faf9f7;
    --card: #ffffff; --warn: #9a6700; --link: #1a4f8a;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 2rem 1.5rem 4rem; background: var(--paper); color: var(--ink);
    font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue",
          "Hiragino Sans", "Yu Gothic", Meiryo, sans-serif;
  }
  .wrap { max-width: 760px; margin: 0 auto; }

  header h1 { margin: 0 0 .25rem; font-size: 1.4rem; font-weight: 600; }
  header .meta { margin: 0; color: var(--muted); font-size: .875rem; }

  ol.runs { list-style: none; margin: 1.5rem 0 0; padding: 0; }
  .run {
    background: var(--card); border: 1px solid var(--line); border-radius: 8px;
    margin: 0 0 .625rem; padding: .75rem 1rem;
    display: flex; flex-wrap: wrap; gap: .25rem 1rem; align-items: baseline;
  }
  /* A fetch that was never reported has nothing to click, so it is dimmed and
     carries the command that would fix it rather than being hidden. Hiding it
     is how a run gets forgotten. */
  .run.unreported { border-left: 4px solid var(--warn); }

  .run .car { font-weight: 600; font-size: 1.05rem; }
  .run .car a { color: var(--link); text-decoration: none; }
  .run .car a:hover { text-decoration: underline; }
  .run .when { color: var(--muted); font-size: .875rem; }
  .run .lots { margin-left: auto; color: var(--muted); font-size: .8125rem;
               letter-spacing: .04em; text-transform: uppercase; }
  .run .dir { flex: 1 1 100%; color: var(--muted); font-size: .75rem;
              font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .run .todo { flex: 1 1 100%; color: var(--warn); font-size: .8125rem; }
  .run .todo code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }

  .empty { margin: 2rem 0; color: var(--muted); }
  .empty code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  footer { margin: 2rem 0 0; color: var(--muted); font-size: .8125rem; }
</style>
</head>
<body>
<div class="wrap">

<header>
  <h1>Auction runs</h1>
  {% if entries %}
  <p class="meta">
    {% if total > entries|length %}
    Showing the {{ entries|length }} most recent of {{ total }} runs.
    {% else %}
    {{ total }} run{{ '' if total == 1 else 's' }}.
    {% endif %}
  </p>
  {% endif %}
</header>

{% if not entries %}
  <p class="empty">No runs yet — <code>uv run python -m banzai24 fetch</code>.</p>
{% else %}
<ol class="runs">
  {% for entry in entries %}
  <li class="run{{ ' unreported' if not entry.href }}">
    <span class="car">
      {% if entry.href %}
      <a href="{{ entry.href }}">{{ entry.car }}</a>
      {% else %}
      {{ entry.car }}
      {% endif %}
    </span>
    <span class="when">{{ entry.when }}</span>
    {% if entry.lots is not none %}
    <span class="lots">{{ entry.lots }} lot{{ '' if entry.lots == 1 else 's' }}</span>
    {% endif %}
    <span class="dir">{{ entry.name }}</span>
    {% if not entry.href %}
    <span class="todo">
      No report yet — <code>uv run python -m banzai24 report runs/{{ entry.name }}</code>
    </span>
    {% endif %}
  </li>
  {% endfor %}
</ol>
{% endif %}

<footer>Rebuilt {{ generated_at }} by <code>report</code>.</footer>

</div>
</body>
</html>
